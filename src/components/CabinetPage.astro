---
import Base from '../layouts/Base.astro';
import { cabinets } from '../data/cabinets.js';
const { slug } = Astro.props;
const c = cabinets[slug];
const product = {
  "@context":"https://schema.org","@type":"Product",
  "name":`DreamAuthentics ${c.name} Custom Arcade Machine`,
  "description":c.blurb,
  "brand":{"@type":"Brand","name":"DreamAuthentics"},
  "category":"Custom Home Arcade Machine",
  "image":`https://dreamauthentics.com${c.konzola}`,
  "offers":{"@type":"Offer","availability":"https://schema.org/InStock","priceCurrency":"USD","url":`https://dreamauthentics.com/arcades/${slug}/`}
};
---
<Base title={`${c.name} — Custom Home Arcade Machine | DreamAuthentics`}
      description={`The DreamAuthentics ${c.name}: a handcrafted custom home arcade machine with custom art, commercial-grade controls, and hundreds of licensed & emulated classic games. ${c.tagline}. Request a quote.`}
      image={c.konzola}>
  <script type="application/ld+json" set:html={JSON.stringify(product)} />
  <section class="cabhero" style={`background-image:url('${c.bg}')`}>
    <div class="wrap inner">
      <div class="copy">
        <div class="tl">Custom Dream Home Arcade</div>
        <h1>{c.name}</h1>
        <p>{c.blurb}</p>
        <p style="margin-top:26px">
          <a class="btn" href="/contact/">Request a Quote</a>
          &nbsp;<a class="btn ghost" href="/portfolio/">See The Art</a>
        </p>
      </div>
      <img class="konz" src={c.konzola} alt={`${c.name} arcade cabinet`} loading="eager" />
    </div>
  </section>

  {c.content && (
    <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226);text-align:center">
      <div class="wrap"><img class="content-graphic" src={c.content} alt={`${c.name} features`} loading="lazy" /></div>
    </section>
  )}

  <section class="section">
    <div class="wrap" style="text-align:center;max-width:820px">
      <span class="eyebrow">Every Cabinet, Made To Order</span>
      <h2>Built Around You</h2>
      <p style="color:var(--mut);font-size:1.12rem">Every {c.name} is hand-built and finished with fully-custom artwork, commercial-grade controls, and hundreds of licensed classic games. Tell us how you play and we'll design the quote around it.</p>
      <p style="margin-top:24px"><a class="btn" href="/contact/">Start Your Build</a></p>
    </div>
  </section>

  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226)">
    <div class="wrap">
      <h2 style="font-size:1.4rem">Other Cabinets</h2>
      <div class="grid cabs" style="margin-top:24px">
        {Object.entries(cabinets).filter(([s])=>s!==slug).map(([s,o]) => (
          <a class="card cab" href={`/arcades/${s}/`}>
            <div class="body"><img src={o.konzola} alt={o.name} style="height:150px" /><div class="name">{o.name}</div></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
