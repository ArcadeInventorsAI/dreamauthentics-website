---
import Base from '../../layouts/Base.astro';
import games from '../../data/games.json';
const fmt = games.length.toLocaleString();
---
<Base title="Game List — DreamAuthentics" description={`Any game, any platform, any controller. DreamAuthentics custom arcades can play up to 30,000 of the greatest games ever made.`}>
  <!-- intro -->
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226)">
    <div class="wrap glhero">
      <div>
        <span class="eyebrow" style="text-align:left">Any Game · Any Platform · Any Controller</span>
        <h2 style="text-align:left;font-size:clamp(1.1rem,2.6vw,1.8rem)">Every Game You Remember</h2>
        <p style="color:var(--mut);font-size:1.14rem;margin-top:16px">
          For more than 20 years, DreamAuthentics has built the finest custom home arcades on the planet —
          and we build the whole thing ourselves: the artwork, the woodwork, the electronics, the controls,
          and the seamless integration that makes it all feel like one machine.
        </p>
        <p style="color:var(--mut);font-size:1.14rem">
          At the heart of your arcade, we can install a fully-configured gaming system capable of playing
          <b style="color:var(--cyan)">up to 30,000 of the greatest games ever made</b> — across every classic
          platform, every genre, and every kind of control, from joysticks and spinners to trackballs and light guns.
        </p>
      </div>
      <img class="konzimg" src="/img/cab/glavnakonzola.png" alt="DreamAuthentics custom arcade" loading="eager"
        onerror="this.src='/img/hero/glavnakonzola.png'" />
    </div>
  </section>

  <!-- stats -->
  <section class="section" style="padding:40px 0"><div class="wrap">
    <div class="glstats">
      <div class="glstat"><div class="n">30,000</div><div class="l">of the best games ever made</div></div>
      <div class="glstat"><div class="n">EVERY<br/>PLATFORM</div><div class="l">every era, every genre</div></div>
      <div class="glstat"><div class="n">ANY<br/>CONTROLLER</div><div class="l">joystick · spinner · trackball · light gun</div></div>
    </div>
  </div></section>

  <!-- works with anything banner -->
  <section style="background:#06101f;padding:0">
    <img src="/img/cab/works-mame.jpg" alt="Works with any game emulator and 100% MAME compatible" style="width:100%;max-width:1600px;margin:0 auto;display:block" loading="lazy" />
  </section>

  <!-- how it works / licensing (clean) -->
  <section class="section"><div class="wrap" style="max-width:900px">
    <span class="eyebrow">You Bring The Games · We Build The Dream</span>
    <h2>Runs Any Emulator. Plays Your Library.</h2>
    <div class="prose" style="margin-top:24px">
      <p>Every DreamAuthentics ships loaded with fully-licensed content, and your machine runs <b style="color:#fff">any emulator and any front-end</b> you like. That means you're free to add your own legally-owned game library — the titles you already own are easy to source from trusted retailers and drop right in, plug-and-play. We build the platform; your collection makes it yours.</p>
      <p>We helped invent this industry, and after two decades we have the platform, the process, and the people to bring the classics you love roaring back to life.</p>
    </div>
    <div class="glart">
      <img src="/img/gamelist/art1.jpg" alt="Custom DreamAuthentics arcade art" loading="lazy" />
      <img src="/img/gamelist/art2.jpg" alt="Custom DreamAuthentics arcade art" loading="lazy" />
      <img src="/img/gamelist/art3.jpg" alt="Custom DreamAuthentics arcade art" loading="lazy" />
    </div>
  </div></section>

  <!-- can I play X -->
  <section class="section" style="background:linear-gradient(180deg,#0b1631,#0a1226);text-align:center">
    <div class="wrap" style="max-width:820px">
      <h2 style="color:var(--gold)">"Can I Play ______ On It?"</h2>
      <p style="color:var(--mut);font-size:1.15rem;margin-top:18px">It's the question we hear most. After 20+ years, the answer is almost always the same — <b style="color:var(--green)">Yes.</b> Give us a call and let's start designing your personal DreamAuthentics.</p>
      <p style="margin-top:26px">
        <a class="btn" href="/contact/">Start Your Build</a>
        &nbsp;<a class="btn ghost" href="tel:8007898424">Call 800-789-8424</a>
      </p>
    </div>
  </section>

  <!-- searchable library -->
  <section class="section"><div class="wrap">
    <span class="eyebrow">A Taste Of The Library</span>
    <h2 style="font-size:clamp(1rem,2.3vw,1.5rem)">{fmt} Classics &amp; Counting</h2>
    <p style="color:var(--mut);text-align:center;max-width:720px;margin:14px auto 0">A sample of the classic titles our custom arcades bring to life. Search for your favorites — then <a href="/contact/">request a quote</a>.</p>
    <div class="form" style="max-width:520px;margin:26px auto">
      <input id="gsearch" type="search" placeholder={`Search ${fmt} games…`} aria-label="Search games" />
      <p class="form-note" id="gcount" style="text-align:center"></p>
    </div>
    <div id="glist" style="columns:4 200px;column-gap:26px;font-size:.95rem;color:var(--mut)">
      {games.map(g => <div class="gitem" style="break-inside:avoid;padding:3px 0">{g}</div>)}
    </div>
    <p style="text-align:center;margin-top:40px"><a class="btn" href="/contact/">Request a Quote</a></p>
  </div></section>
  <script is:inline>
    const items=[...document.querySelectorAll('.gitem')];
    const box=document.getElementById('gsearch'), cnt=document.getElementById('gcount'), total=items.length;
    function upd(){const q=box.value.trim().toLowerCase();let n=0;for(const it of items){const s=!q||it.textContent.toLowerCase().includes(q);it.style.display=s?'':'none';if(s)n++;}cnt.textContent=q?`${n} of ${total.toLocaleString()} games`:`${total.toLocaleString()} games`;}
    box.addEventListener('input',upd);upd();
  </script>
</Base>
