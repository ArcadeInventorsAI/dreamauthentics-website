---
import Base from '../../layouts/Base.astro';
import slides from '../../data/portfolio.json';
---
<Base title="Cabinet Art & Design Portfolio — DreamAuthentics Home Arcades"
  description="Explore the DreamAuthentics design art portfolio — museum-grade, fully-custom cabinet artwork created for one-of-a-kind home arcade machines. See what we can build for you.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226)">
    <div class="wrap" style="text-align:center;max-width:900px">
      <span class="eyebrow">Two Decades Of Dream Machines</span>
      <h2>Design Art Portfolio</h2>
      <p style="color:var(--mut);font-size:1.15rem">A curated library of professionally-designed DreamAuthentics custom cabinets — {slides.length} pieces of original arcade art from our design archive. This is what "custom" really looks like.</p>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {slides.map((s,i)=>(
        <a class="card" href={s} target="_blank" rel="noopener">
          <img src={s} alt={`DreamAuthentics design portfolio ${i+1}`} loading="lazy" style="aspect-ratio:4/3;object-fit:cover"/>
        </a>
      ))}
    </div>
  </div></section>
</Base>
