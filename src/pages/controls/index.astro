---
import Base from '../../layouts/Base.astro';
const panels=[
  {n:'Quad',h:'/controls/quad/',d:'Four-player custom control panel'},
  {n:'CO2',h:'/controls/co2/',d:'Compact two-player layout'},
  {n:'Classic',h:'/controls/classic/',d:'The golden-age two-player standard'},
  {n:'Solitaire',h:'/controls/solitaire/',d:'Single-player precision panel'},
];
const parts=[
  {n:'Illuminated Joysticks',h:'/controls/illuminated-joysticks/',d:'LED-lit arcade joysticks'},
  {n:'Tornado Spinner',h:'/controls/tornado-spinner/',d:'Precision arcade spinner'},
];
---
<Base title="Controls & Arcade Parts — DreamAuthentics">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226)">
    <div class="wrap" style="text-align:center;max-width:860px">
      <span class="eyebrow">Built To Play, Built To Last</span><h2>Controls &amp; Arcade Parts</h2>
      <p style="color:var(--mut);font-size:1.12rem">Commercial-grade custom control panels and arcade parts — the same components we put in our cabinets, engineered to survive years of play.</p>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <h2 style="font-size:1.4rem">Custom Control Panels</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));margin-top:20px">
      {panels.map(p=>(<a class="card" href={p.h}><div class="body"><h3>{p.n}</h3><p style="color:var(--mut)">{p.d}</p></div></a>))}
    </div>
    <h2 id="parts" style="font-size:1.4rem;margin-top:50px">Arcade Parts</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));margin-top:20px">
      {parts.map(p=>(<a class="card" href={p.h}><div class="body"><h3>{p.n}</h3><p style="color:var(--mut)">{p.d}</p></div></a>))}
    </div>
    <p style="text-align:center;margin-top:40px"><a class="btn" href="/contact/">Ask About Controls</a></p>
  </div></section>
</Base>
