---
import Base from '../../layouts/Base.astro';
import { cabinets } from '../../data/cabinets.js';
const cabs=Object.entries(cabinets).map(([s,o])=>({n:o.name,i:o.konzola,h:`/arcades/${s}/`}));
---
<Base title="Custom Home Arcade Machines & Cabinets — DreamAuthentics" description="Explore DreamAuthentics custom home arcade machines — Excalibur, Katana, Ultra Quad, Sting, Eladius & Kiocade. Handcrafted cabinets, custom art, thousands of licensed & emulated games. Request a quote.">
  <section class="section" style="background:linear-gradient(180deg,#0f1d3d,#0a1226)">
    <div class="wrap" style="text-align:center;max-width:860px">
      <span class="eyebrow">Custom Dream Home Arcades</span><h2>Pick Your Personal Video Arcade</h2>
      <p style="color:var(--mut);font-size:1.12rem">Every DreamAuthentics cabinet is built to order and finished with fully-custom art. Choose a model below, then request a quote — we design it around you.</p>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <div class="grid cabs">
      {cabs.map(c=>(<a class="card cab" href={c.h}><div class="body"><img src={c.i} alt={c.n} style="height:200px"/><div class="name">{c.n}</div></div></a>))}
    </div>
    <p style="text-align:center;margin-top:34px"><a class="btn" href="/contact/">Request a Quote</a></p>
  </div></section>
</Base>
