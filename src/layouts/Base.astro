---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { asSeenOn } from '../data/nav.js';
const {
  title = 'Custom Home Arcade Machines — DreamAuthentics | Since 2000',
  description = 'DreamAuthentics builds the finest custom home arcade machines on the planet — handcrafted cabinets, custom art, and up to 30,000 licensed & emulated classic games. Defining the personal video arcade since 2000. As seen on FOX, CBS, MTV & G4.',
  image = '/img/cab/works-mame.jpg',
  ogType = 'website',
} = Astro.props;
const site = 'https://dreamauthentics.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
// GA4 Measurement ID — set PUBLIC_GA_ID at build time when the GA4 property exists (see SEO notes).
const GA_ID = import.meta.env.PUBLIC_GA_ID || '';
const org = {
  "@context":"https://schema.org","@type":"Organization",
  "name":"DreamAuthentics","url":site,"logo":`${site}/img/brand/logo.png`,
  "description":"Custom home arcade machine design and manufacturing since 2000, handcrafted in Indianapolis, Indiana.",
  "foundingDate":"2000","telephone":"+1-800-789-8424",
  "address":{"@type":"PostalAddress","addressLocality":"Indianapolis","addressRegion":"IN","addressCountry":"US"},
  "areaServed":"US",
  "sameAs":["https://www.youtube.com/@RickBarretto"]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="DreamAuthentics" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0a1226" />
  <link rel="icon" href="/img/brand/logo.png" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`} />}
</head>
<body>
  <div class="callbar">
    <div class="wrap">
      <a href="tel:8007898424"><img src="/img/brand/header-call-icon.png" alt="" class="callicon" />800-789-8424</a>
      <span class="tag">Industry Leading Custom Gaming<br/>Innovators Since 2000</span>
    </div>
  </div>

  <header class="masthead">
    <div class="wrap">
      <a class="logo" href="/"><img src="/img/brand/logo.png" alt="DreamAuthentics" /></a>
      <div class="seenon">
        <img class="seentitle" src="/img/brand/asseen.png" alt="As Seen On" />
        <div class="logos">
          {asSeenOn.map(l => <img src={l.src} alt={l.alt} title={l.alt} />)}
        </div>
      </div>
    </div>
  </header>

  <Nav />

  <main>
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="cols">
        <div>
          <h4>DreamAuthentics</h4>
          <p>Defining the personal video arcade since 2000. Custom home arcades and controls — handcrafted in Indianapolis, Indiana, USA.</p>
          <p><a href="tel:8007898424">800-789-8424</a></p>
        </div>
        <div>
          <h4>Arcades</h4>
          <p><a href="/arcades/excalibur/">Excalibur</a><br/><a href="/arcades/katana/">Katana</a><br/><a href="/arcades/ultra-quad/">Ultra Quad</a><br/><a href="/arcades/">All Cabinets</a></p>
        </div>
        <div>
          <h4>Explore</h4>
          <p><a href="/portfolio/">Design Art Portfolio</a><br/><a href="/gallery/">Gallery</a><br/><a href="/press/">Press &amp; Media</a><br/><a href="/trade-my-arcade/">Trade My Arcade</a></p>
        </div>
        <div>
          <h4>Company</h4>
          <p><a href="/about/">About Us</a><br/><a href="/contact/">Contact</a></p>
        </div>
      </div>
      <div class="fine">© {new Date().getFullYear()} DreamAuthentics. All rights reserved. · As seen on G4, FOX, CBS, MTV, HGTV &amp; Good Morning America.</div>
    </div>
  </footer>
</body>
</html>
